⇇!DOCTYPE⇔gw1⇉⇇META⇔Sat Apr 04 2026 17:52:06 GMT-0600 (Mountain Daylight Time)⇉⇇TITLE⇔Shattered Chronos⇔Claude⇉⇇JSCONTENT⇔/* ↴=== IMPORTANT NOTE ===↴This gearworks test project was generated by Claude.↴It is being used by the Gear Works Team to show off↴Gearworks' capabilities. Note that Claude did not↴do everything right, and some changes were made by↴humans to make the system work.↴Gearworks is not AI generated.↴======================↴*/↴↴// Set correct aspect ratio↴gearWorks.morph(475);↴↴// ==================== GAME STATE ====================↴var STATE = {↴  screen: "title",       // title | map | battle | dialogue | gameover | ending↴  frame: 0,↴  fadeAlpha: 1,↴  fadingIn: true,↴  fadeSpeed: 0.03↴};↴↴↴// ==================== PLAYER ====================↴var player = {↴  name: "Kairos",↴  hp: 80, maxHp: 80,↴  mp: 40, maxMp: 40,↴  atk: 12, def: 6, spd: 10,↴  level: 1, xp: 0, xpNext: 30,↴  fragments: 0,          // time fragments collected (max 5)↴  items: ["Chrono Shard", "Chrono Shard", "Echo Herb"],↴  skills: ["Strike", "Time Pulse", "Chrono Break"],↴  gold: 20,↴  unlockedRegions: [0],  // indices into REGIONS array↴  visitedRegions: []↴};↴↴// ==================== REGIONS ====================↴var REGIONS = [↴  {↴    name: "The Frosted Meridian",↴    subtitle: "Time is frozen here.",↴    color: "↯1a3a5c",↴    accentColor: "↯7ecfff",↴    timeEffect: "freeze",↴    description: "A tundra where every moment is locked in crystalline stasis. Creatures repeat their final action endlessly.",↴    enemy: { name: "Frost Wraith", hp: 30, maxHp: 30, atk: 8, def: 2, xp: 12, gold: 5, color: "↯aaddff" },↴    bossName: "Chronolith",↴    boss: { name: "Chronolith", hp: 80, maxHp: 80, atk: 14, def: 6, xp: 40, gold: 20, color: "↯55aaff", isBoss: true },↴    fragmentId: 0,↴    npcName: "Eira the Still",↴    npcText: [↴      "You... you move. How? Everything here stopped long ago.",↴      "The Chronolith guards the first shard. It has frozen itself in a loop of rage.",↴      "Strike it when it pauses — that is its only weakness. Go, unaffected one."↴    ],↴    unlocks: [1, 2],↴    bgStars: true↴  },↴  {↴    name: "The Looping Bazaar",↴    subtitle: "Repeat. Reset. Repeat.",↴    color: "↯2d1a00",↴    accentColor: "↯ffbb44",↴    timeEffect: "loop",↴    description: "A bustling market trapped in an endless Tuesday afternoon. Merchants sell the same goods, forget every purchase.",↴    enemy: { name: "Echo Merchant", hp: 38, maxHp: 38, atk: 10, def: 3, xp: 15, gold: 8, color: "↯ffdd88" },↴    bossName: "The Eternal Vendor",↴    boss: { name: "Eternal Vendor", hp: 95, maxHp: 95, atk: 16, def: 8, xp: 50, gold: 25, color: "↯ffaa00", isBoss: true },↴    fragmentId: 1,↴    npcName: "Merchant Solvay",↴    npcText: [↴      "Buy! Sell! ...Wait, have we met? I feel like we've met. Every day I feel like we've met.",↴      "The Eternal Vendor appeared when time broke. It loops the whole district.",↴      "Each loop it grows stronger. You must disrupt its cycle before it resets again."↴    ],↴    unlocks: [3],↴    bgStars: false↴  },↴  {↴    name: "The Withered Expanse",↴    subtitle: "Time bleeds forward, then backward.",↴    color: "↯1a0a2e",↴    accentColor: "↯cc44ff",↴    timeEffect: "distort",↴    description: "A wasteland where the past and future bleed into the present. Ancient ruins coexist with their own rubble.",↴    enemy: { name: "Paradox Beast", hp: 45, maxHp: 45, atk: 13, def: 4, xp: 18, gold: 9, color: "↯aa66ff" },↴    bossName: "The Unborn King",↴    boss: { name: "Unborn King", hp: 110, maxHp: 110, atk: 18, def: 10, xp: 60, gold: 30, color: "↯9900ff", isBoss: true },↴    fragmentId: 2,↴    npcName: "Relic Voss",↴    npcText: [↴      "Past. Future. They've swapped here. I remember tomorrow but not yesterday.",↴      "The Unborn King was never born — yet it rules. A paradox made flesh.",↴      "Its past-self and future-self fight each other. Attack when they overlap."↴    ],↴    unlocks: [4],↴    bgStars: false↴  },↴  {↴    name: "The Sunken Archive",↴    subtitle: "Time accelerates to oblivion.",↴    color: "↯001a10",↴    accentColor: "↯44ffaa",↴    timeEffect: "rush",↴    description: "A vast library where time races so fast that books write, age, and turn to dust in seconds.",↴    enemy: { name: "Aged Scribe", hp: 50, maxHp: 50, atk: 15, def: 5, xp: 22, gold: 11, color: "↯66ffbb" },↴    bossName: "The Archivist Prime",↴    boss: { name: "Archivist Prime", hp: 130, maxHp: 130, atk: 20, def: 12, xp: 70, gold: 35, color: "↯00cc77", isBoss: true },↴    fragmentId: 3,↴    npcName: "Scholar Denn",↴    npcText: [↴      "I wrote three hundred years of history in the last hour. It's maddening.",↴      "The Archivist Prime has catalogued every possible timeline — including your defeat.",↴      "Surprise it. Do something it hasn't written down. Break the pattern."↴    ],↴    unlocks: [],↴    bgStars: false↴  },↴  {↴    name: "The Apex Rift",↴    subtitle: "The source. The end. The choice.",↴    color: "↯0a0a0a",↴    accentColor: "↯ffffff",↴    timeEffect: "void",↴    description: "Where the Chrono Device shattered. All timelines converge here into a single trembling point.",↴    enemy: { name: "Rift Shard", hp: 60, maxHp: 60, atk: 18, def: 6, xp: 28, gold: 15, color: "↯ffffff" },↴    bossName: "The Architect of Hours",↴    boss: { name: "Architect of Hours", hp: 200, maxHp: 200, atk: 25, def: 15, xp: 100, gold: 50, color: "↯ffffaa", isBoss: true },↴    fragmentId: 4,↴    npcName: "The Device's Echo",↴    npcText: [↴      "You have come far, Kairos. Five fragments. Five broken pieces of me.",↴      "I am the Chrono Device. Or what remains of my memory.",↴      "When you defeat the Architect, you will face a choice. Think carefully.",↴      "Restore me — and time returns, but so does every tragedy it held.",↴      "Destroy me — and time ends. No more suffering. No more anything.",↴      "Or... reshape me. A new flow. Uncertain. Dangerous. But yours to define."↴    ],↴    unlocks: [],↴    bgStars: true↴  }↴];↴↴// ==================== WORLD MAP ====================↴var MAP_NODES = [↴  { x: 200, y: 200, regionIdx: 0 },↴  { x: 380, y: 130, regionIdx: 1 },↴  { x: 120, y: 330, regionIdx: 2 },↴  { x: 350, y: 310, regionIdx: 3 },↴  { x: 240, y: 390, regionIdx: 4 }↴];↴var MAP_CONNECTIONS = [↴  [0,1],[0,2],[1,3],[2,4],[3,4]↴];↴↴// ==================== CURRENT REGION ====================↴var currentRegionIdx = 0;↴var currentRegion = REGIONS[0];↴var regionBossDefeated = [false, false, false, false, false];↴var fragmentCollected = [false, false, false, false, false];↴↴// ==================== BATTLE STATE ====================↴var battle = {↴↴  enemy: null,↴  playerTurn: true,↴  log: [],↴  phase: "select",    // select | animating | enemyturn | victory | defeat↴  selectedAction: 0,↴  animTimer: 0,↴  shake: 0,↴  flashColor: null,↴  flashTimer: 0,↴  bgPulse: 0↴};↴↴// ==================== DIALOGUE STATE ====================↴var dialogue = {↴  lines: [],↴  current: 0,↴  speaker: "",↴  afterDialogue: null,  // function to call when done↴  charIdx: 0,↴  charTimer: 0↴};↴↴// ==================== MENU STATE ====================↴var menuState = {↴  open: false,↴  tab: "status",   // status | items | skills↴  selectedItem: 0↴};↴↴// ==================== INPUT HELPERS ====================↴var prevKeys = [];↴function keyJustPressed(k) {↴  return keyboard.includes(k) && !prevKeys.includes(k);↴}↴↴// ==================== TITLE SCREEN ====================↴var titleAnim = 0;↴var titleParticles = [];↴function initTitleParticles() {↴  titleParticles = [];↴  for (var i = 0; i < 60; i++) {↴    titleParticles.push({↴      x: Math.random() * 480,↴      y: Math.random() * 480,↴      vx: (Math.random() - 0.5) * 0.4,↴      vy: (Math.random() - 0.5) * 0.4,↴      size: Math.random() * 2 + 0.5,↴      alpha: Math.random(),↴      hue: Math.floor(Math.random() * 60) + 180↴    });↴  }↴}↴initTitleParticles();↴↴function drawTitle() {↴  draw.background("↯000010");↴↴  // Starfield particles↴  for (var i = 0; i < titleParticles.length; i++) {↴    var p = titleParticles[i];↴    p.x += p.vx; p.y += p.vy;↴    if (p.x < 0) p.x = 480; if (p.x > 480) p.x = 0;↴    if (p.y < 0) p.y = 480; if (p.y > 480) p.y = 0;↴    p.alpha += (Math.random() - 0.5) * 0.05;↴    if (p.alpha < 0.1) p.alpha = 0.1;↴    if (p.alpha > 1) p.alpha = 1;↴    draw.fillStyle = "hsla(" + p.hue + ",80%,80%," + p.alpha + ")";↴    draw.beginPath();↴    draw.arc(p.x, p.y, p.size, 0, Math.PI * 2);↴    draw.fill();↴  }↴↴  // Animated clock gears (drawn with arcs)↴  var cx = 240, cy = 130;↴  var gearR = 55 + Math.sin(titleAnim * 0.01) * 3;↴  draw.strokeStyle = "↯445599";↴  draw.lineWidth = 3;↴  draw.beginPath(); draw.arc(cx, cy, gearR, 0, Math.PI * 2); draw.stroke();↴  // Gear teeth↴  for (var t = 0; t < 12; t++) {↴    var ang = (t / 12) * Math.PI * 2 + titleAnim * 0.005;↴    var ix = cx + Math.cos(ang) * gearR;↴    var iy = cy + Math.sin(ang) * gearR;↴    var ox = cx + Math.cos(ang) * (gearR + 8);↴    var oy = cy + Math.sin(ang) * (gearR + 8);↴    draw.lineWidth = 4;↴    draw.strokeStyle = "↯5566bb";↴    draw.beginPath(); draw.moveTo(ix, iy); draw.lineTo(ox, oy); draw.stroke();↴  }↴  // Clock hands↴  var hourAng = titleAnim * 0.008;↴  var minAng = titleAnim * 0.03;↴  draw.strokeStyle = "↯aaccff";↴  draw.lineWidth = 3;↴  draw.beginPath();↴  draw.moveTo(cx, cy);↴  draw.lineTo(cx + Math.cos(hourAng) * 28, cy + Math.sin(hourAng) * 28);↴  draw.stroke();↴  draw.lineWidth = 2;↴  draw.strokeStyle = "↯ffffff";↴  draw.beginPath();↴  draw.moveTo(cx, cy);↴  draw.lineTo(cx + Math.cos(minAng) * 40, cy + Math.sin(minAng) * 40);↴  draw.stroke();↴  // Crack lines across clock↴  draw.strokeStyle = "rgba(255,100,100,0.7)";↴  draw.lineWidth = 1;↴  draw.beginPath(); draw.moveTo(cx - 10, cy - 20); draw.lineTo(cx + 30, cy + 10); draw.stroke();↴  draw.beginPath(); draw.moveTo(cx + 5, cy - 35); draw.lineTo(cx - 20, cy + 20); draw.stroke();↴↴  // Title text↴  draw.textAlign = "center";↴  draw.fillStyle = "↯ffffff";↴  draw.font = "bold 36px monospace";↴  draw.fillText("SHATTERED", 240, 240);↴  draw.fillStyle = "↯88aaff";↴  draw.font = "bold 28px monospace";↴  draw.fillText("CHRONOS", 240, 275);↴  draw.font = "13px monospace";↴  draw.fillStyle = "↯aaaaaa";↴  draw.fillText("A Time-Fractured RPG Adventure", 240, 305);↴↴  // Prompt↴  var blink = Math.floor(titleAnim / 30) % 2;↴  if (blink == 0) {↴    draw.fillStyle = "↯ffdd88";↴    draw.font = "14px monospace";↴    draw.fillText("Press ENTER to begin", 240, 355);↴  }↴↴  draw.font = "11px monospace";↴  draw.fillStyle = "↯555577";↴  draw.fillText("Arrow Keys: Navigate  |  Enter/Z: Confirm  |  X: Cancel", 240, 460);↴↴  if (keyJustPressed("Enter")) {↴    startGame();↴  }↴}↴↴// ==================== START GAME ====================↴function startGame() {↴  startFadeTransition("map");↴}↴↴// ==================== FADE TRANSITION ====================↴function startFadeTransition(nextScreen) {↴  STATE.fadingIn = false;↴  STATE.fadeAlpha = 0;↴  STATE._nextScreen = nextScreen;↴}↴↴function updateFade() {↴  if (!STATE.fadingIn) {↴    STATE.fadeAlpha += STATE.fadeSpeed * 2;↴    if (STATE.fadeAlpha >= 1) {↴      STATE.fadeAlpha = 1;↴      STATE.fadingIn = true;↴      STATE.screen = STATE._nextScreen;↴    }↴  } else {↴    STATE.fadeAlpha -= STATE.fadeSpeed;↴    if (STATE.fadeAlpha < 0) STATE.fadeAlpha = 0;↴  }↴}↴↴function drawFadeOverlay() {↴  if (STATE.fadeAlpha > 0) {↴    draw.fillStyle = "rgba(0,0,0," + STATE.fadeAlpha + ")";↴    draw.fillRect(0, 0, 480, 480);↴  }↴}↴↴// ==================== WORLD MAP SCREEN ====================↴var mapCursor = 0;↴var mapAnim = 0;↴↴function drawMap() {↴  mapAnim++;↴  // Background↴  draw.background("↯08080f");↴  // Starfield↴  for (var s = 0; s < 80; s++) {↴    var sx = ((s * 73 + mapAnim * 0.2) % 480);↴    var sy = ((s * 37 + 17) % 480);↴    var sa = 0.3 + 0.3 * Math.sin(s + mapAnim * 0.05);↴    draw.fillStyle = "rgba(180,200,255," + sa + ")";↴    draw.beginPath();↴    draw.arc(sx, sy, 0.8, 0, Math.PI * 2);↴    draw.fill();↴  }↴↴  draw.textAlign = "center";↴  draw.font = "bold 16px monospace";↴  draw.fillStyle = "↯aaaaff";↴  draw.fillText("WORLD MAP", 240, 30);↴  draw.font = "11px monospace";↴  draw.fillStyle = "↯556688";↴  draw.fillText("Fragments: " + player.fragments + " / 5", 240, 50);↴↴  // Draw connections↴  for (var c = 0; c < MAP_CONNECTIONS.length; c++) {↴    var a = MAP_CONNECTIONS[c][0];↴    var b = MAP_CONNECTIONS[c][1];↴    var na = MAP_NODES[a]; var nb = MAP_NODES[b];↴    var unlocked = player.unlockedRegions.indexOf(a) >= 0 && player.unlockedRegions.indexOf(b) >= 0;↴    draw.strokeStyle = unlocked ? "↯334466" : "↯221133";↴    draw.lineWidth = unlocked ? 2 : 1;↴    draw.beginPath();↴    draw.moveTo(na.x, na.y + 60);↴    draw.lineTo(nb.x, nb.y + 60);↴    draw.stroke();↴  }↴↴  // Draw nodes↴  for (var n = 0; n < MAP_NODES.length; n++) {↴    var node = MAP_NODES[n];↴    var reg = REGIONS[node.regionIdx];↴    var isUnlocked = player.unlockedRegions.indexOf(node.regionIdx) >= 0;↴    var isSelected = n == mapCursor;↴    var hasFragment = fragmentCollected[reg.fragmentId];↴    var nx = node.x, ny = node.y + 60;↴↴    // Node circle↴    var pulse = isSelected ? Math.sin(mapAnim * 0.1) * 5 : 0;↴    draw.fillStyle = isUnlocked ? reg.color : "↯111111";↴    draw.strokeStyle = isSelected ? reg.accentColor : (isUnlocked ? reg.accentColor + "88" : "↯333333");↴    draw.lineWidth = isSelected ? 3 : 1.5;↴    draw.beginPath();↴    draw.arc(nx, ny, 18 + pulse, 0, Math.PI * 2);↴    draw.fill();↴    draw.stroke();↴↴    // Fragment indicator↴    if (hasFragment) {↴      draw.fillStyle = "↯ffdd44";↴      draw.beginPath();↴      draw.arc(nx + 13, ny - 13, 5, 0, Math.PI * 2);↴      draw.fill();↴    }↴↴    // Region name↴    draw.textAlign = "center";↴    draw.font = "9px monospace";↴    draw.fillStyle = isUnlocked ? reg.accentColor : "↯444444";↴    draw.fillText(reg.name.split(" ").slice(0,2).join(" "), nx, ny + 32);↴  }↴↴  // Info panel for selected node↴  var selNode = MAP_NODES[mapCursor];↴  var selReg = REGIONS[selNode.regionIdx];↴  var selUnlocked = player.unlockedRegions.indexOf(selNode.regionIdx) >= 0;↴↴  draw.fillStyle = "rgba(0,0,0,0.7)";↴  draw.fillRect(10, 390, 460, 80);↴  draw.strokeStyle = selUnlocked ? selReg.accentColor : "↯333333";↴  draw.lineWidth = 1;↴  draw.strokeRect(10, 390, 460, 80);↴  draw.textAlign = "left";↴  draw.font = "bold 13px monospace";↴  draw.fillStyle = selUnlocked ? selReg.accentColor : "↯555555";↴  draw.fillText(selReg.name, 20, 408);↴  draw.font = "11px monospace";↴  draw.fillStyle = "↯aaaaaa";↴  draw.fillText(selUnlocked ? selReg.subtitle : "??? LOCKED ???", 20, 424);↴  if (selUnlocked) {↴    draw.fillStyle = "↯888888";↴    var bossStatus = regionBossDefeated[selNode.regionIdx] ? "[Boss Defeated]" : "[Boss Active]";↴    draw.fillText(bossStatus + "  |  " + selReg.timeEffect.toUpperCase(), 20, 440);↴    draw.fillStyle = "↯ffdd88";↴    draw.fillText("Enter: Explore  |  Arrow Keys: Move Cursor", 20, 460);↴  } else {↴    draw.fillStyle = "↯555555";↴    draw.fillText("Defeat bosses in connected regions to unlock.", 20, 440);↴  }↴↴  // Player HP bar at top↴  drawHudBar(10, 8, 150, 12, player.hp, player.maxHp, "↯44cc66", "↯112211", "HP");↴  drawHudBar(170, 8, 100, 12, player.mp, player.maxMp, "↯4488ff", "↯111122", "MP");↴  draw.textAlign = "left";↴  draw.font = "10px monospace";↴  draw.fillStyle = "↯aaaaaa";↴  draw.fillText("Lv." + player.level + "  XP:" + player.xp + "/" + player.xpNext, 280, 18);↴↴  // Press M for menu↴  draw.textAlign = "right";↴  draw.font = "10px monospace";↴  draw.fillStyle = "↯667788";↴  draw.fillText("[M] Menu", 470, 18);↴↴  // Input↴  if (keyJustPressed("ArrowRight") || keyJustPressed("ArrowDown")) {↴    mapCursor = (mapCursor + 1) % MAP_NODES.length;↴  }↴  if (keyJustPressed("ArrowLeft") || keyJustPressed("ArrowUp")) {↴    mapCursor = (mapCursor - 1 + MAP_NODES.length) % MAP_NODES.length;↴  }↴  if (keyJustPressed("Enter") || keyJustPressed("z")) {↴    var ri = MAP_NODES[mapCursor].regionIdx;↴    if (player.unlockedRegions.indexOf(ri) >= 0) {↴      enterRegion(ri);↴    }↴  }↴  if (keyJustPressed("m") && STATE.frame > 100) {↴    menuState.open = !menuState.open;↴    STATE.frame = 0;↴  }↴↴  if (menuState.open) {↴    drawMenu();↴  }↴}↴↴// ==================== ENTER REGION ====================↴function enterRegion(idx) {↴  currentRegionIdx = idx;↴  currentRegion = REGIONS[idx];↴  if (player.visitedRegions.indexOf(idx) < 0) {↴    player.visitedRegions.push(idx);↴    // Trigger NPC dialogue on first visit↴    openDialogue(currentRegion.npcName, currentRegion.npcText, function() {↴      STATE.screen = "region";↴    });↴  } else {↴    STATE.screen = "region";↴  }↴}↴↴// ==================== REGION SCREEN ====================↴var regionAnim = 0;↴var regionChoice = 0;↴var regionParticles = [];↴↴function initRegionParticles() {↴  regionParticles = [];↴  for (var i = 0; i < 30; i++) {↴    regionParticles.push({↴      x: Math.random() * 480,↴      y: Math.random() * 280,↴      vx: (Math.random() - 0.5) * 1,↴      vy: (Math.random() - 0.5) * 0.5,↴      size: Math.random() * 3 + 1,↴      life: Math.random()↴    });↴  }↴}↴↴function drawRegion() {↴  regionAnim++;↴  if (regionParticles.length == 0) initRegionParticles();↴  var reg = currentRegion;↴↴  // Background gradient-ish↴  draw.fillStyle = reg.color;↴  draw.fillRect(0, 0, 480, 480);↴↴  // Time effect particles↴  for (var i = 0; i < regionParticles.length; i++) {↴    var p = regionParticles[i];↴    if (reg.timeEffect == "freeze") {↴      // Static snowflakes↴      p.vy = 0.2; p.vx = Math.sin(regionAnim * 0.02 + i) * 0.3;↴    } else if (reg.timeEffect == "loop") {↴      // Circular orbits↴      p.x = 240 + Math.cos(regionAnim * 0.02 + i * 0.4) * (50 + i * 5);↴      p.y = 140 + Math.sin(regionAnim * 0.02 + i * 0.4) * (30 + i * 2);↴    } else if (reg.timeEffect == "distort") {↴      p.x += Math.sin(regionAnim * 0.05 + i) * 1.5;↴      p.y += Math.cos(regionAnim * 0.03 + i) * 1.5;↴    } else if (reg.timeEffect == "rush") {↴      p.x += p.vx * 3; p.y += p.vy * 3;↴    } else {↴      p.x += p.vx; p.y += p.vy;↴    }↴    if (p.x < 0) p.x = 480; if (p.x > 480) p.x = 0;↴    if (p.y < 0) p.y = 280; if (p.y > 280) p.y = 0;↴    p.life += 0.01;↴    if (p.life > 1) p.life = 0;↴    draw.fillStyle = reg.accentColor + Math.floor(p.life * 120 + 40).toString(16).padStart(2,'0');↴    draw.beginPath();↴    draw.arc(p.x, p.y, p.size, 0, Math.PI * 2);↴    draw.fill();↴  }↴↴  // Region title panel↴  draw.fillStyle = "rgba(0,0,0,0.6)";↴  draw.fillRect(0, 0, 480, 80);↴  draw.textAlign = "center";↴  draw.font = "bold 18px monospace";↴  draw.fillStyle = reg.accentColor;↴  draw.fillText(reg.name, 240, 30);↴  draw.font = "12px monospace";↴  draw.fillStyle = "↯aaaaaa";↴  draw.fillText(reg.subtitle, 240, 50);↴  draw.font = "10px monospace";↴  draw.fillStyle = "↯667788";↴  draw.fillText(reg.timeEffect.toUpperCase() + " ANOMALY", 240, 68);↴↴  // Description↴  draw.fillStyle = "rgba(0,0,0,0.55)";↴  draw.fillRect(20, 90, 440, 50);↴  draw.textAlign = "left";↴  draw.font = "10px monospace";↴  draw.fillStyle = "↯cccccc";↴  var words = reg.description.split(" ");↴  var line1 = "", line2 = "";↴  for (var w = 0; w < words.length; w++) {↴    if ((line1 + words[w]).length < 52) line1 += words[w] + " ";↴    else line2 += words[w] + " ";↴  }↴  draw.fillText(line1, 28, 108);↴  draw.fillText(line2, 28, 124);↴↴  // Boss status↴  var bossStatus = regionBossDefeated[currentRegionIdx];↴  draw.fillStyle = bossStatus ? "↯55ff88" : "↯ff6644";↴  draw.textAlign = "center";↴  draw.font = "11px monospace";↴  draw.fillText("Boss: " + reg.bossName + (bossStatus ? " [DEFEATED]" : " [ACTIVE]"), 240, 162);↴↴  // Fragment status↴  var fragCollected = fragmentCollected[reg.fragmentId];↴  draw.fillStyle = fragCollected ? "↯ffdd44" : "↯888888";↴  draw.fillText("Fragment ↯" + (reg.fragmentId + 1) + (fragCollected ? " [COLLECTED]" : " [MISSING]"), 240, 180);↴↴  // Action menu↴  var actions = ["Fight Enemy", "Fight Boss", "Talk to " + reg.npcName, "Return to Map"];↴  if (bossStatus && !fragCollected) actions.splice(1, 0, "Collect Fragment");↴↴  draw.fillStyle = "rgba(0,0,0,0.75)";↴  draw.fillRect(80, 210, 320, actions.length * 38 + 20);↴  draw.strokeStyle = reg.accentColor + "88";↴  draw.lineWidth = 1;↴  draw.strokeRect(80, 210, 320, actions.length * 38 + 20);↴↴  for (var a = 0; a < actions.length; a++) {↴    var ay = 238 + a * 38;↴    if (a == regionChoice) {↴      draw.fillStyle = reg.accentColor + "33";↴      draw.fillRect(84, ay - 18, 312, 34);↴      draw.fillStyle = reg.accentColor;↴      draw.textAlign = "center";↴      draw.font = "bold 13px monospace";↴      draw.fillText("> " + actions[a] + " <", 240, ay);↴    } else {↴      draw.fillStyle = "↯aaaaaa";↴      draw.textAlign = "center";↴      draw.font = "13px monospace";↴      draw.fillText(actions[a], 240, ay);↴    }↴  }↴↴  draw.font = "10px monospace";↴  draw.fillStyle = "↯445566";↴  draw.fillText("Arrow Keys: Navigate  |  Enter: Confirm  |  X: Map", 240, 460);↴↴  // Input↴  if (keyJustPressed("ArrowUp")) regionChoice = (regionChoice - 1 + actions.length) % actions.length;↴  if (keyJustPressed("ArrowDown")) regionChoice = (regionChoice + 1) % actions.length;↴  if (keyJustPressed("Enter") || keyJustPressed("z")) {↴    var chosen = actions[regionChoice];↴    if (chosen == "Fight Enemy") {↴      startBattle(false);↴    } else if (chosen == "Fight Boss") {↴      if (!bossStatus) startBattle(true);↴    } else if (chosen.indexOf("Collect Fragment") >= 0) {↴      collectFragment();↴    } else if (chosen.indexOf("Talk") >= 0) {↴      openDialogue(reg.npcName, reg.npcText, function() { STATE.screen = "region"; });↴    } else if (chosen == "Return to Map") {↴      regionParticles = [];↴      regionChoice = 0;↴      startFadeTransition("map");↴    }↴  }↴  if (keyJustPressed("x") || keyJustPressed("Escape")) {↴    regionParticles = [];↴    regionChoice = 0;↴    startFadeTransition("map");↴  }↴}↴↴// ==================== COLLECT FRAGMENT ====================↴function collectFragment() {↴  var reg = currentRegion;↴  if (!fragmentCollected[reg.fragmentId]) {↴    fragmentCollected[reg.fragmentId] = true;↴    player.fragments++;↴    openDialogue("System", ["Fragment of Time recovered! (" + player.fragments + "/5)"], function() {↴      STATE.screen = "region";↴      if (player.fragments >= 5) {↴        // Unlock final region↴        if (player.unlockedRegions.indexOf(4) < 0) player.unlockedRegions.push(4);↴        openDialogue("The Device's Echo", ["All five fragments recovered. The Apex Rift opens to you..."], function() {↴          STATE.screen = "region";↴        });↴      }↴    });↴  }↴}↴↴// ==================== BATTLE SYSTEM ====================↴var battleAnim = 0;↴↴function startBattle(isBoss) {↴  var reg = currentRegion;↴  var enemyTemplate = isBoss ? reg.boss : reg.enemy;↴  battle.enemy = {↴    name: enemyTemplate.name,↴    hp: enemyTemplate.hp,↴    maxHp: enemyTemplate.maxHp,↴    atk: enemyTemplate.atk,↴    def: enemyTemplate.def,↴    xp: enemyTemplate.xp,↴    gold: enemyTemplate.gold,↴    color: enemyTemplate.color,↴    isBoss: isBoss↴  };↴  battle.playerTurn = true;↴  battle.log = ["A " + battle.enemy.name + " appears!"];↴  battle.phase = "select";↴  battle.selectedAction = 0;↴  battle.shake = 0;↴  battle.flashColor = null;↴  battle.flashTimer = 0;↴  battle.bgPulse = 0;↴  battleAnim = 0;↴  battle._isBoss = isBoss;↴  startFadeTransition("battle");↴}↴↴function drawBattle() {↴  battleAnim++;↴  var reg = currentRegion;↴  var enemy = battle.enemy;↴↴  // Background↴  draw.background(reg.color);↴  battle.bgPulse += 0.04;↴  var pulseAlpha = 0.15 + 0.08 * Math.sin(battle.bgPulse);↴  draw.fillStyle = "rgba(0,0,0," + pulseAlpha + ")";↴  draw.fillRect(0, 0, 480, 480);↴↴  // Flash overlay↴  if (battle.flashTimer > 0) {↴    draw.fillStyle = battle.flashColor;↴    draw.fillRect(0, 0, 480, 480);↴    battle.flashTimer--;↴  }↴↴  // Enemy sprite (drawn as geometric shapes)↴  var ex = 240 + (battle.shake > 0 ? (Math.random() - 0.5) * 10 : 0);↴  var ey = 160;↴  if (battle.shake > 0) battle.shake--;↴  drawEnemySprite(ex, ey, enemy, battleAnim);↴↴  // Enemy name + HP bar↴  draw.textAlign = "center";↴  draw.font = "bold 14px monospace";↴  draw.fillStyle = enemy.color;↴  draw.fillText(enemy.name, 240, 60);↴  drawHudBar(140, 68, 200, 14, enemy.hp, enemy.maxHp, "↯ff4444", "↯330000", "HP");↴↴  // Player info panel↴  draw.fillStyle = "rgba(0,0,0,0.8)";↴  draw.fillRect(0, 290, 480, 190);↴  draw.strokeStyle = reg.accentColor + "66";↴  draw.lineWidth = 1;↴  draw.strokeRect(0, 290, 480, 190);↴↴  draw.textAlign = "left";↴  draw.font = "bold 12px monospace";↴  draw.fillStyle = "↯ffffff";↴  draw.fillText(player.name + "   Lv." + player.level, 14, 310);↴  drawHudBar(10, 316, 180, 12, player.hp, player.maxHp, "↯44cc66", "↯112211", "HP");↴  drawHudBar(10, 334, 180, 12, player.mp, player.maxMp, "↯4488ff", "↯111122", "MP");↴↴  // Battle log↴  draw.fillStyle = "rgba(0,0,0,0.5)";↴  draw.fillRect(200, 295, 270, 55);↴  draw.font = "10px monospace";↴  draw.fillStyle = "↯cccccc";↴  var logStart = Math.max(0, battle.log.length - 3);↴  for (var l = logStart; l < battle.log.length; l++) {↴    draw.fillText(battle.log[l], 206, 312 + (l - logStart) * 14);↴  }↴↴  // Action menu↴  if (battle.phase == "select" && battle.playerTurn) {↴    var actions = ["Strike", "Time Pulse  (4 MP)", "Chrono Break  (8 MP)", "Use Item", "Flee"];↴    draw.font = "12px monospace";↴    for (var a = 0; a < actions.length; a++) {↴      var ay = 365 + a * 22;↴      if (a == battle.selectedAction) {↴        draw.fillStyle = reg.accentColor + "44";↴        draw.fillRect(10, ay - 15, 220, 20);↴        draw.fillStyle = reg.accentColor;↴        draw.font = "bold 12px monospace";↴        draw.fillText("> " + actions[a], 14, ay);↴      } else {↴        draw.fillStyle = "↯888888";↴        draw.font = "12px monospace";↴        draw.fillText("  " + actions[a], 14, ay);↴      }↴    }↴↴    // Item list on right↴    draw.textAlign = "left";↴    draw.font = "11px monospace";↴    draw.fillStyle = "↯556677";↴    draw.fillText("Items: " + player.items.length, 240, 365);↴    for (var it = 0; it < Math.min(player.items.length, 5); it++) {↴      draw.fillStyle = "↯aaaacc";↴      draw.fillText("- " + player.items[it], 240, 380 + it * 18);↴    }↴  } else if (battle.phase == "animating") {↴    draw.textAlign = "center";↴    draw.font = "bold 13px monospace";↴    draw.fillStyle = "↯ffdd88";↴    draw.fillText("...", 240, 420);↴  }↴↴  // Input handling↴  if (battle.phase == "select" && battle.playerTurn) {↴    if (keyJustPressed("ArrowUp")) battle.selectedAction = (battle.selectedAction - 1 + 5) % 5;↴    if (keyJustPressed("ArrowDown")) battle.selectedAction = (battle.selectedAction + 1) % 5;↴    if (keyJustPressed("Enter") || keyJustPressed("z")) {↴      executeBattleAction(battle.selectedAction);↴    }↴    if (keyJustPressed("x") || keyJustPressed("Escape")) {↴      // Try to flee↴      executeBattleAction(4);↴    }↴  }↴↴  // Enemy turn trigger↴  if (battle.phase == "enemyturn") {↴    battle.phase = "animating";↴    battle.animTimer = 40;↴  }↴  if (battle.phase == "animating" && !battle.playerTurn) {↴    battle.animTimer--;↴    if (battle.animTimer <= 0) {↴      doEnemyAction();↴    }↴  }↴↴  // Victory/defeat handling↴  if (battle.phase == "victory") {↴    drawBattleResult(true);↴  }↴  if (battle.phase == "defeat") {↴    drawBattleResult(false);↴  }↴}↴↴function drawEnemySprite(cx, cy, enemy, frame) {↴  var c = enemy.color;↴  var bob = Math.sin(frame * 0.05) * 4;↴  cy += bob;↴↴  if (enemy.isBoss) {↴    // Large boss sprite↴    // Body↴    draw.fillStyle = c;↴    draw.beginPath(); draw.arc(cx, cy, 40, 0, Math.PI * 2); draw.fill();↴    // Inner detail↴    draw.fillStyle = "rgba(0,0,0,0.4)";↴    draw.beginPath(); draw.arc(cx, cy, 28, 0, Math.PI * 2); draw.fill();↴    // Eyes↴    draw.fillStyle = "↯ffffff";↴    draw.beginPath(); draw.arc(cx - 14, cy - 8, 7, 0, Math.PI * 2); draw.fill();↴    draw.beginPath(); draw.arc(cx + 14, cy - 8, 7, 0, Math.PI * 2); draw.fill();↴    draw.fillStyle = "↯000000";↴    draw.beginPath(); draw.arc(cx - 14, cy - 8, 4, 0, Math.PI * 2); draw.fill();↴    draw.beginPath(); draw.arc(cx + 14, cy - 8, 4, 0, Math.PI * 2); draw.fill();↴    // Crown / spikes for boss↴    draw.fillStyle = c;↴    for (var sp = 0; sp < 6; sp++) {↴      var sang = (sp / 6) * Math.PI * 2 - Math.PI / 2 + frame * 0.01;↴      draw.beginPath();↴      draw.moveTo(cx + Math.cos(sang) * 40, cy + Math.sin(sang) * 40);↴      draw.lineTo(cx + Math.cos(sang + 0.15) * 55, cy + Math.sin(sang + 0.15) * 55);↴      draw.lineTo(cx + Math.cos(sang + 0.3) * 40, cy + Math.sin(sang + 0.3) * 40);↴      draw.fill();↴    }↴    // HP crack overlay↴    var hpRatio = enemy.hp / enemy.maxHp;↴    if (hpRatio < 0.5) {↴      draw.strokeStyle = "rgba(255,0,0,0.5)";↴      draw.lineWidth = 2;↴      draw.beginPath(); draw.moveTo(cx - 15, cy - 30); draw.lineTo(cx + 5, cy + 10); draw.stroke();↴      draw.beginPath(); draw.moveTo(cx + 10, cy - 35); draw.lineTo(cx - 10, cy + 5); draw.stroke();↴    }↴  } else {↴    // Regular enemy sprite↴    draw.fillStyle = c;↴    draw.beginPath(); draw.arc(cx, cy, 25, 0, Math.PI * 2); draw.fill();↴    draw.fillStyle = "rgba(0,0,0,0.3)";↴    draw.beginPath(); draw.arc(cx, cy, 16, 0, Math.PI * 2); draw.fill();↴    // Eyes↴    draw.fillStyle = "↯ffffff";↴    draw.beginPath(); draw.arc(cx - 8, cy - 5, 5, 0, Math.PI * 2); draw.fill();↴    draw.beginPath(); draw.arc(cx + 8, cy - 5, 5, 0, Math.PI * 2); draw.fill();↴    draw.fillStyle = "↯000000";↴    draw.beginPath(); draw.arc(cx - 8, cy - 5, 3, 0, Math.PI * 2); draw.fill();↴    draw.beginPath(); draw.arc(cx + 8, cy - 5, 3, 0, Math.PI * 2); draw.fill();↴    // Limbs (two lines)↴    draw.strokeStyle = c;↴    draw.lineWidth = 3;↴    draw.beginPath(); draw.moveTo(cx - 25, cy + 5); draw.lineTo(cx - 15, cy + 18); draw.stroke();↴    draw.beginPath(); draw.moveTo(cx + 25, cy + 5); draw.lineTo(cx + 15, cy + 18); draw.stroke();↴  }↴}↴↴function executeBattleAction(actionIdx) {↴  var enemy = battle.enemy;↴  if (actionIdx == 0) {↴    // Strike↴    var dmg = Math.max(1, player.atk - enemy.def + Math.floor(Math.random() * 5) - 2);↴    enemy.hp -= dmg;↴    battle.log.push("You strike for " + dmg + " damage!");↴    battle.shake = 8;↴    battle.flashColor = "rgba(255,100,100,0.2)";↴    battle.flashTimer = 6;↴  } else if (actionIdx == 1) {↴    // Time Pulse↴    if (player.mp < 4) {↴      battle.log.push("Not enough MP!");↴      return;↴    }↴    player.mp -= 4;↴    var dmg = Math.max(1, player.atk * 1.5 - enemy.def + Math.floor(Math.random() * 6));↴    enemy.hp -= dmg;↴    battle.log.push("Time Pulse hits for " + dmg + " damage!");↴    battle.shake = 12;↴    battle.flashColor = "rgba(100,150,255,0.3)";↴    battle.flashTimer = 8;↴  } else if (actionIdx == 2) {↴    // Chrono Break↴    if (player.mp < 8) {↴      battle.log.push("Not enough MP!");↴      return;↴    }↴    player.mp -= 8;↴    var dmg = Math.max(1, player.atk * 2.2 - enemy.def + Math.floor(Math.random() * 8));↴    enemy.hp -= dmg;↴    battle.log.push("Chrono Break: " + dmg + " massive damage!");↴    battle.shake = 20;↴    battle.flashColor = "rgba(255,200,50,0.4)";↴    battle.flashTimer = 12;↴  } else if (actionIdx == 3) {↴    // Use Item↴    if (player.items.length == 0) {↴      battle.log.push("No items!");↴      return;↴    }↴    var item = player.items.shift();↴    if (item == "Chrono Shard") {↴      var heal = 25;↴      player.hp = Math.min(player.maxHp, player.hp + heal);↴      battle.log.push("Used Chrono Shard! Healed " + heal + " HP.");↴    } else if (item == "Echo Herb") {↴      var mpRec = 15;↴      player.mp = Math.min(player.maxMp, player.mp + mpRec);↴      battle.log.push("Used Echo Herb! Recovered " + mpRec + " MP.");↴    } else {↴      battle.log.push("Used " + item + ".");↴    }↴    battle.flashColor = "rgba(80,255,80,0.2)";↴    battle.flashTimer = 6;↴  } else if (actionIdx == 4) {↴    // Flee↴    if (enemy.isBoss) {↴      battle.log.push("Cannot flee from boss!");↴      return;↴    }↴    if (Math.random() < 0.5) {↴      battle.log.push("Escaped!");↴      battle.phase = "victory";↴      STATE.frame = 0;↴      battle._fled = true;↴      return;↴    } else {↴      battle.log.push("Couldn't flee!");↴    }↴  }↴↴  if (enemy.hp <= 0) {↴    enemy.hp = 0;↴    battle.phase = "victory";↴    STATE.frame = 0;↴    battle._fled = false;↴    return;↴  }↴↴  battle.playerTurn = false;↴  battle.phase = "enemyturn";↴}↴↴function doEnemyAction() {↴  var enemy = battle.enemy;↴  var dmg = Math.max(1, enemy.atk - player.def + Math.floor(Math.random() * 6) - 3);↴  // Boss has special attacks↴  if (enemy.isBoss && Math.random() < 0.3) {↴    dmg = Math.floor(dmg * 1.8);↴    battle.log.push(enemy.name + " uses TIME CRUSH for " + dmg + "!");↴  } else {↴    battle.log.push(enemy.name + " attacks for " + dmg + " damage!");↴  }↴  player.hp -= dmg;↴  battle.flashColor = "rgba(255,50,50,0.25)";↴  battle.flashTimer = 5;↴↴  if (player.hp <= 0) {↴    player.hp = 0;↴    battle.phase = "defeat";↴    STATE.frame = 0;↴    return;↴  }↴↴  battle.playerTurn = true;↴  battle.phase = "select";↴}↴↴function drawBattleResult(won) {↴  draw.fillStyle = "rgba(0,0,0,0.8)";↴  draw.fillRect(60, 150, 360, 180);↴  draw.textAlign = "center";↴↴  if (won && !battle._fled) {↴    var enemy = battle.enemy;↴    draw.font = "bold 22px monospace";↴    draw.fillStyle = "↯ffdd44";↴    draw.fillText("VICTORY!", 240, 200);↴    draw.font = "13px monospace";↴    draw.fillStyle = "↯aaffaa";↴    draw.fillText("+" + enemy.xp + " XP   +" + enemy.gold + " Gold", 240, 230);↴    draw.fillStyle = "↯cccccc";↴    if (enemy.isBoss) {↴      draw.fillText("Boss defeated! Path forward opens.", 240, 255);↴    }↴    draw.font = "11px monospace";↴    draw.fillStyle = "↯888888";↴    draw.fillText("Press ENTER to continue", 240, 300);↴↴    if ((keyJustPressed("Enter") || keyJustPressed("z")) && STATE.frame > 100) {↴      // Award XP + gold↴      player.xp += enemy.xp;↴      player.gold += enemy.gold;↴      // Level up check↴      while (player.xp >= player.xpNext) {↴        player.xp -= player.xpNext;↴        player.level++;↴        player.xpNext = Math.floor(player.xpNext * 1.5);↴        player.maxHp += 8; player.hp = player.maxHp;↴        player.maxMp += 4; player.mp = player.maxMp;↴        player.atk += 2; player.def += 1;↴        battle.log.push("Level Up! Now Lv." + player.level);↴      }↴      // Partial HP/MP restore after battle↴      player.hp = Math.min(player.maxHp, player.hp + 10);↴      player.mp = Math.min(player.maxMp, player.mp + 5);↴      // Replenish 1 item occasionally↴      if (Math.random() < 0.4) player.items.push("Chrono Shard");↴↴      if (enemy.isBoss && battle._isBoss) {↴        regionBossDefeated[currentRegionIdx] = true;↴        // Unlock connected regions↴        var reg = currentRegion;↴        for (var u = 0; u < reg.unlocks.length; u++) {↴          if (player.unlockedRegions.indexOf(reg.unlocks[u]) < 0) {↴            player.unlockedRegions.push(reg.unlocks[u]);↴          }↴        }↴      }↴      startFadeTransition("region");↴    }↴  } else if (battle._fled) {↴    draw.font = "bold 18px monospace";↴    draw.fillStyle = "↯88aaff";↴    draw.fillText("Got away safely.", 240, 230);↴    draw.font = "11px monospace";↴    draw.fillStyle = "↯888888";↴    draw.fillText("Press ENTER to continue", 240, 300);↴    if ((keyJustPressed("Enter") || keyJustPressed("z")) && STATE.frame > 100) {↴      startFadeTransition("region");↴    }↴  } else {↴    // Defeat↴    draw.font = "bold 22px monospace";↴    draw.fillStyle = "↯ff4444";↴    draw.fillText("DEFEATED", 240, 200);↴    draw.font = "13px monospace";↴    draw.fillStyle = "↯aaaaaa";↴    draw.fillText("Time fractures around your fall...", 240, 235);↴    draw.fillText("But you remain unaffected.", 240, 255);↴    draw.font = "11px monospace";↴    draw.fillStyle = "↯888888";↴    draw.fillText("Press ENTER to recover", 240, 300);↴    if ((keyJustPressed("Enter") || keyJustPressed("z")) && STATE.frame > 100) {↴      // Revive with partial HP↴      player.hp = Math.floor(player.maxHp * 0.4);↴      player.mp = Math.floor(player.maxMp * 0.4);↴      startFadeTransition("region");↴    }↴  }↴}↴↴// ==================== DIALOGUE SYSTEM ====================↴function openDialogue(speaker, lines, afterFn) {↴  dialogue.lines = lines;↴  dialogue.current = 0;↴  dialogue.speaker = speaker;↴  dialogue.afterDialogue = afterFn;↴  dialogue.charIdx = 0;↴  dialogue.charTimer = 0;↴  STATE.screen = "dialogue";↴}↴↴function drawDialogue() {↴  // Draw underlying region or map as backdrop↴  draw.background("↯0a0a1a");↴  // Dialogue box↴  draw.fillStyle = "rgba(0,0,10,0.92)";↴  draw.fillRect(20, 300, 440, 160);↴  draw.strokeStyle = "↯5566aa";↴  draw.lineWidth = 2;↴  draw.strokeRect(20, 300, 440, 160);↴↴  // Speaker name tab↴  draw.fillStyle = "↯334477";↴  draw.fillRect(30, 288, 140, 22);↴  draw.strokeStyle = "↯5566aa";↴  draw.lineWidth = 1;↴  draw.strokeRect(30, 288, 140, 22);↴  draw.textAlign = "left";↴  draw.font = "bold 11px monospace";↴  draw.fillStyle = "↯aabbff";↴  draw.fillText(dialogue.speaker, 36, 303);↴↴  // Typewriter text↴  var currentLine = dialogue.lines[dialogue.current] || "";↴  dialogue.charTimer++;↴  if (dialogue.charTimer % 2 == 0 && dialogue.charIdx < currentLine.length) {↴    dialogue.charIdx++;↴  }↴  var visibleText = currentLine.substring(0, dialogue.charIdx);↴↴  // Word wrap↴  draw.font = "12px monospace";↴  var words = visibleText.split(" ");↴  var lines = [""]; var li = 0;↴  for (var w = 0; w < words.length; w++) {↴    if ((lines[li] + words[w]).length < 42) {↴      lines[li] += words[w] + " ";↴    } else {↴      li++; lines.push(words[w] + " ");↴    }↴  }↴  draw.fillStyle = "↯ddddee";↴  for (var dl = 0; dl < Math.min(lines.length, 5); dl++) {↴    draw.fillText(lines[dl], 34, 330 + dl * 20);↴  }↴↴  // Page counter↴  draw.textAlign = "right";↴  draw.font = "10px monospace";↴  draw.fillStyle = "↯445566";↴  draw.fillText((dialogue.current + 1) + "/" + dialogue.lines.length, 452, 450);↴↴  // Advance prompt↴  var allVisible = dialogue.charIdx >= currentLine.length;↴  if (allVisible) {↴    var blink = Math.floor(STATE.frame / 20) % 2;↴    if (blink == 0) {↴      draw.fillStyle = "↯88aaff";↴      draw.font = "11px monospace";↴      draw.fillText("ENTER ▶", 452, 450);↴    }↴    if (keyJustPressed("Enter") || keyJustPressed("z") || keyJustPressed(" ")) {↴      dialogue.current++;↴      dialogue.charIdx = 0;↴      dialogue.charTimer = 0;↴      if (dialogue.current >= dialogue.lines.length) {↴        if (dialogue.afterDialogue) dialogue.afterDialogue();↴        else STATE.screen = "map";↴      }↴    }↴  } else {↴    // Skip to end of line↴    if (keyJustPressed("Enter") || keyJustPressed("z")) {↴      dialogue.charIdx = currentLine.length;↴    }↴  }↴}↴↴// ==================== MENU OVERLAY ====================↴function drawMenu() {↴  draw.fillStyle = "rgba(0,0,0,0.88)";↴  draw.fillRect(60, 30, 360, 420);↴  draw.strokeStyle = "↯445588";↴  draw.lineWidth = 2;↴  draw.strokeRect(60, 30, 360, 420);↴↴  // Tabs↴  var tabs = ["STATUS", "ITEMS", "SKILLS"];↴  for (var t = 0; t < tabs.length; t++) {↴    var tx = 70 + t * 115;↴    var active = menuState.tab == tabs[t].toLowerCase();↴    draw.fillStyle = active ? "↯223366" : "↯111122";↴    draw.fillRect(tx, 38, 105, 24);↴    draw.strokeStyle = active ? "↯5566aa" : "↯334455";↴    draw.lineWidth = 1;↴    draw.strokeRect(tx, 38, 105, 24);↴    draw.textAlign = "center";↴    draw.font = (active ? "bold " : "") + "11px monospace";↴    draw.fillStyle = active ? "↯aabbff" : "↯556677";↴    draw.fillText(tabs[t], tx + 52, 54);↴  }↴↴  // Content↴  if (menuState.tab == "status") {↴    draw.textAlign = "left";↴    draw.font = "bold 14px monospace";↴    draw.fillStyle = "↯ffffff";↴    draw.fillText(player.name, 80, 90);↴    draw.font = "12px monospace";↴    draw.fillStyle = "↯aaaaaa";↴    draw.fillText("Level: " + player.level, 80, 112);↴    draw.fillText("XP: " + player.xp + " / " + player.xpNext, 80, 130);↴    draw.fillText("Gold: " + player.gold, 80, 148);↴    drawHudBar(80, 158, 300, 14, player.hp, player.maxHp, "↯44cc66", "↯112211", "HP");↴    drawHudBar(80, 180, 300, 14, player.mp, player.maxMp, "↯4488ff", "↯111122", "MP");↴    draw.fillStyle = "↯aaaaaa";↴    draw.fillText("ATK: " + player.atk + "   DEF: " + player.def + "   SPD: " + player.spd, 80, 215);↴    draw.fillText("Fragments: " + player.fragments + " / 5", 80, 235);↴    draw.font = "11px monospace";↴    draw.fillStyle = "↯667788";↴    for (var f = 0; f < 5; f++) {↴      draw.fillStyle = fragmentCollected[f] ? "↯ffdd44" : "↯333344";↴      draw.fillText("[" + (f+1) + "] " + REGIONS[f].name.split(" ").slice(0,2).join(" "), 80, 258 + f * 18);↴    }↴  } else if (menuState.tab == "items") {↴    draw.textAlign = "left";↴    draw.font = "bold 12px monospace";↴    draw.fillStyle = "↯aabbff";↴    draw.fillText("ITEMS (" + player.items.length + ")", 80, 90);↴    if (player.items.length == 0) {↴      draw.fillStyle = "↯556677";↴      draw.font = "12px monospace";↴      draw.fillText("No items.", 80, 120);↴    } else {↴      // Count unique items↴      var itemCounts = {};↴      for (var i = 0; i < player.items.length; i++) {↴        itemCounts[player.items[i]] = (itemCounts[player.items[i]] || 0) + 1;↴      }↴      var keys = Object.keys(itemCounts);↴      for (var k = 0; k < keys.length; k++) {↴        var ky = 112 + k * 22;↴        draw.fillStyle = "↯ddddcc";↴        draw.font = "12px monospace";↴        draw.fillText(keys[k] + "  x" + itemCounts[keys[k]], 80, ky);↴      }↴    }↴    draw.font = "10px monospace";↴    draw.fillStyle = "↯556677";↴    draw.fillText("Chrono Shard: Restores 25 HP", 80, 280);↴    draw.fillText("Echo Herb: Restores 15 MP", 80, 298);↴    draw.fillText("Items are used automatically in battle.", 80, 316);↴  } else if (menuState.tab == "skills") {↴    draw.textAlign = "left";↴    draw.font = "bold 12px monospace";↴    draw.fillStyle = "↯aabbff";↴    draw.fillText("SKILLS", 80, 90);↴    var skillDesc = [↴      ["Strike", "0 MP", "A direct physical blow."],↴      ["Time Pulse", "4 MP", "Releases a burst of temporal energy."],↴      ["Chrono Break", "8 MP", "Shatters time around the enemy. High damage."]↴    ];↴    for (var s = 0; s < skillDesc.length; s++) {↴      var sy = 115 + s * 55;↴      draw.fillStyle = "↯88aaff";↴      draw.font = "bold 13px monospace";↴      draw.fillText(skillDesc[s][0] + "   [" + skillDesc[s][1] + "]", 80, sy);↴      draw.fillStyle = "↯888899";↴      draw.font = "11px monospace";↴      draw.fillText(skillDesc[s][2], 80, sy + 16);↴    }↴  }↴↴  // Tab switch input↴  if (keyJustPressed("ArrowLeft")) {↴    var ti = tabs.indexOf(menuState.tab.toUpperCase());↴    menuState.tab = tabs[(ti - 1 + tabs.length) % tabs.length].toLowerCase();↴  }↴  if (keyJustPressed("ArrowRight")) {↴    var ti = tabs.indexOf(menuState.tab.toUpperCase());↴    menuState.tab = tabs[(ti + 1) % tabs.length].toLowerCase();↴  }↴  if ((keyJustPressed("m") || keyJustPressed("x") || keyJustPressed("Escape")) && STATE.frame > 100) {↴    menuState.open = false;↴  }↴↴  draw.textAlign = "center";↴  draw.font = "10px monospace";↴  draw.fillStyle = "↯445566";↴  draw.fillText("Left/Right: Switch Tab  |  M/X: Close", 240, 440);↴}↴↴// ==================== ENDING SCREEN ====================↴var endingChoice = 0;↴var endingAnim = 0;↴var endingPhase = "choose"; // choose | cutscene | credits↴↴function checkEnding() {↴  // Called after beating the final boss↴  openDialogue("The Device's Echo", [↴    "The Architect of Hours falls. The fragments pulse in your hands.",↴    "The Device can be whole again. But how?",↴    "Choose, Kairos. This is what you were left unaffected for."↴  ], function() {↴    STATE.screen = "ending";↴    endingPhase = "choose";↴    endingChoice = 0;↴  });↴}↴↴function drawEnding() {↴  endingAnim++;↴↴  if (endingPhase == "choose") {↴    draw.background("↯05050f");↴    // Cosmic background↴    for (var s = 0; s < 100; s++) {↴      var sa = 0.2 + 0.5 * Math.sin(s * 7.3 + endingAnim * 0.02);↴      draw.fillStyle = "rgba(200,210,255," + sa + ")";↴      var sx = (s * 137 + 30) % 480;↴      var sy = (s * 89 + 15) % 360;↴      draw.beginPath(); draw.arc(sx, sy, 1, 0, Math.PI * 2); draw.fill();↴    }↴↴    // Fractured clock at top↴    var cx = 240, cy = 80;↴    draw.strokeStyle = "↯446699";↴    draw.lineWidth = 2;↴    draw.beginPath(); draw.arc(cx, cy, 45, 0, Math.PI * 2); draw.stroke();↴    // Crack↴    draw.strokeStyle = "↯ff6666";↴    draw.lineWidth = 1.5;↴    draw.beginPath(); draw.moveTo(cx - 20, cy - 40); draw.lineTo(cx + 15, cy + 30); draw.stroke();↴    draw.beginPath(); draw.moveTo(cx + 10, cy - 44); draw.lineTo(cx - 12, cy + 20); draw.stroke();↴    // Fragments orbiting↴    for (var ff = 0; ff < 5; ff++) {↴      var fang = (ff / 5) * Math.PI * 2 + endingAnim * 0.015;↴      var fx = cx + Math.cos(fang) * 55;↴      var fy = cy + Math.sin(fang) * 30;↴      draw.fillStyle = "↯ffdd44";↴      draw.beginPath(); draw.arc(fx, fy, 4, 0, Math.PI * 2); draw.fill();↴    }↴↴    draw.textAlign = "center";↴    draw.font = "bold 16px monospace";↴    draw.fillStyle = "↯ffffff";↴    draw.fillText("THE FINAL CHOICE", 240, 160);↴    draw.font = "11px monospace";↴    draw.fillStyle = "↯888899";↴    draw.fillText("Five fragments. One decision. All of time.", 240, 182);↴↴    var choices = [↴      { label: "RESTORE TIME", desc: "Rebuild the device. Time flows again,\nbut all its tragedies return.", color: "↯44aaff" },↴      { label: "DESTROY TIME", desc: "Shatter the device forever.\nNo more suffering. No more anything.", color: "↯ff4444" },↴      { label: "RESHAPE TIME", desc: "Forge a new flow. Uncertain.\nDangerous. But yours to define.", color: "↯ffdd44" }↴    ];↴↴    for (var ch = 0; ch < choices.length; ch++) {↴      var cy2 = 230 + ch * 80;↴      var isSelected = ch == endingChoice;↴      draw.fillStyle = isSelected ? choices[ch].color + "22" : "rgba(0,0,0,0.5)";↴      draw.fillRect(60, cy2 - 20, 360, 65);↴      draw.strokeStyle = isSelected ? choices[ch].color : "↯222233";↴      draw.lineWidth = isSelected ? 2 : 1;↴      draw.strokeRect(60, cy2 - 20, 360, 65);↴      draw.fillStyle = isSelected ? choices[ch].color : "↯666677";↴      draw.font = (isSelected ? "bold " : "") + "14px monospace";↴      draw.fillText((isSelected ? "> " : "  ") + choices[ch].label, 240, cy2 + 2);↴      var descLines = choices[ch].desc.split("\n");↴      draw.font = "10px monospace";↴      draw.fillStyle = isSelected ? "↯cccccc" : "↯444455";↴      draw.fillText(descLines[0], 240, cy2 + 20);↴      if (descLines[1]) draw.fillText(descLines[1], 240, cy2 + 34);↴    }↴↴    draw.font = "10px monospace";↴    draw.fillStyle = "↯445566";↴    draw.fillText("Up/Down: Choose  |  Enter: Decide", 240, 468);↴↴    if (keyJustPressed("ArrowUp")) endingChoice = (endingChoice - 1 + 3) % 3;↴    if (keyJustPressed("ArrowDown")) endingChoice = (endingChoice + 1) % 3;↴    if (keyJustPressed("Enter") || keyJustPressed("z")) {↴      endingPhase = "cutscene";↴      endingAnim = 0;↴    }↴  } else if (endingPhase == "cutscene") {↴    drawEndingCutscene();↴  } else if (endingPhase == "credits") {↴    drawCredits();↴  }↴}↴↴function drawEndingCutscene() {↴  draw.background("↯000000");↴  endingAnim++;↴↴  var endings = [↴    {↴      title: "ENDING: THE RESTORED CLOCK",↴      lines: [↴        "You press the five fragments together.",↴        "The Chrono Device hums back to life.",↴        "Time flows. Wars resume. Loves bloom.",↴        "Children are born. Old men die in peace.",↴        "The world is imperfect — and alive.",↴        "You stand still, as always, unaffected.",↴        "Watching time flow without you in it.",↴        "It was never yours to keep.",↴        "It was only yours to return.",↴        "[ END ]"↴      ],↴      color: "↯44aaff"↴    },↴    {↴      title: "ENDING: THE SILENT COSMOS",↴      lines: [↴        "You crush the fragments underfoot.",↴        "One by one, the loops stop.",↴        "One by one, the frozen moments melt.",↴        "And then — nothing.",↴        "No war. No love. No memory.",↴        "The universe exhales its last second.",↴        "Peace, at last — in the absolute.",↴        "You too, finally, stop.",↴        "Unaffected no more.",↴        "[ END ]"↴      ],↴      color: "↯ff4444"↴    },↴    {↴      title: "ENDING: THE NEW MERIDIAN",↴      lines: [↴        "You don't restore. You don't destroy.",↴        "You reshape.",↴        "Time bends under your hands like clay.",↴        "Some loops linger — beauty preserved.",↴        "Some frozen moments thaw — pain released.",↴        "You build a timeline no one has written.",↴        "It is messy. Dangerous. Contradictory.",↴        "It is yours.",↴        "And for the first time — you move with it.",↴        "[ END ]"↴      ],↴      color: "↯ffdd44"↴    }↴  ];↴↴  var ending = endings[endingChoice];↴  var linesPerPage = 1;↴  var lineIdx = Math.floor(endingAnim / 90);↴  var charProgress = (endingAnim % 90) / 90;↴↴  // Background pulse↴  var r = parseInt(ending.color.slice(1,3), 16);↴  var g = parseInt(ending.color.slice(3,5), 16);↴  var b = parseInt(ending.color.slice(5,7), 16);↴  draw.fillStyle = "rgba(" + r + "," + g + "," + b + ",0.05)";↴  draw.fillRect(0, 0, 480, 480);↴↴  // Fading clock symbol↴  draw.strokeStyle = "rgba(100,100,150,0.1)";↴  draw.lineWidth = 1;↴  draw.beginPath(); draw.arc(240, 240, 180, 0, Math.PI * 2); draw.stroke();↴↴  draw.textAlign = "center";↴  draw.font = "bold 14px monospace";↴  draw.fillStyle = ending.color;↴  draw.fillText(ending.title, 240, 80);↴↴  // Show lines up to current↴  for (var l = 0; l <= Math.min(lineIdx, ending.lines.length - 1); l++) {↴    var lineAlpha = l < lineIdx ? 0.8 : charProgress;↴    draw.fillStyle = "rgba(220,220,230," + lineAlpha + ")";↴    draw.font = l == lineIdx ? "italic 13px monospace" : "13px monospace";↴    draw.fillText(ending.lines[l], 240, 140 + l * 30);↴  }↴↴  if (lineIdx >= ending.lines.length) {↴    var blink = Math.floor(endingAnim / 30) % 2;↴    if (blink == 0) {↴      draw.fillStyle = "↯667788";↴      draw.font = "11px monospace";↴      draw.fillText("Press ENTER for credits", 240, 460);↴    }↴    if (keyJustPressed("Enter") || keyJustPressed("z")) {↴      endingPhase = "credits";↴      endingAnim = 0;↴    }↴  }↴}↴↴function drawCredits() {↴  draw.background("↯000008");↴  endingAnim++;↴↴  var creditLines = [↴    "",↴    "SHATTERED CHRONOS",↴    "A GearWorks RPG",↴    "",↴    "Built with GearWorks",↴    "gearworks.org",↴    "",↴    "Design & Code",↴    "Generated by Claude",↴    "Proofread by GW Team",↴    "Written in GearWorks JS",↴    "Using only the core draw API",↴    "",↴    "REGIONS VISITED",↴    ...REGIONS.map(function(r) { return r.name; }),↴    "",↴    "Thank you for playing.",↴    "",↴    "Press ENTER to return to title"↴  ];↴↴  var scrollY = 480 - (endingAnim * 0.2);↴↴  draw.textAlign = "center";↴  for (var cl = 0; cl < creditLines.length; cl++) {↴    var cy = scrollY + cl * 28;↴    if (cy < -30 || cy > 510) continue;↴    var isTitle = creditLines[cl] == "SHATTERED CHRONOS";↴    var isSection = ["Built with GearWorks", "Design & Code", "REGIONS VISITED", "Thank you for playing."].indexOf(creditLines[cl]) >= 0;↴    draw.font = isTitle ? "bold 20px monospace" : (isSection ? "bold 13px monospace" : "12px monospace");↴    draw.fillStyle = isTitle ? "↯88aaff" : (isSection ? "↯ffdd88" : "↯aaaaaa");↴    if (creditLines[cl]) draw.fillText(creditLines[cl], 240, cy);↴  }↴↴  if (scrollY + creditLines.length * 28 < 0 || keyJustPressed("Enter") || keyJustPressed("z")) {↴    // Reset game to title↴    player.hp = player.maxHp;↴    player.mp = player.maxMp;↴    startFadeTransition("title");↴  }↴}↴↴// ==================== HUD HELPERS ====================↴function drawHudBar(x, y, w, h, val, max, fillColor, bgColor, label) {↴  draw.fillStyle = bgColor;↴  draw.fillRect(x, y, w, h);↴  var ratio = Math.max(0, val / max);↴  draw.fillStyle = fillColor;↴  draw.fillRect(x, y, Math.floor(w * ratio), h);↴  draw.strokeStyle = "↯445566";↴  draw.lineWidth = 1;↴  draw.strokeRect(x, y, w, h);↴  draw.font = "9px monospace";↴  draw.textAlign = "left";↴  draw.fillStyle = "↯ffffff";↴  draw.fillText(label + " " + val + "/" + max, x + 3, y + h - 2);↴}↴↴// ==================== MAIN GAME LOOP ====================↴function forever() {↴  STATE.frame++;↴  updateFade();↴↴  if (STATE.screen == "title") {↴    titleAnim++;↴    drawTitle();↴  } else if (STATE.screen == "map") {↴    drawMap();↴  } else if (STATE.screen == "region") {↴    drawRegion();↴  } else if (STATE.screen == "battle") {↴    drawBattle();↴  } else if (STATE.screen == "dialogue") {↴    drawDialogue();↴  } else if (STATE.screen == "ending") {↴    drawEnding();↴  }↴↴  drawFadeOverlay();↴↴  // Check for final boss victory → ending↴  if (STATE.screen == "region" && currentRegionIdx == 4 &&↴      regionBossDefeated[4] && !STATE._endingTriggered) {↴    STATE._endingTriggered = true;↴    checkEnding();↴  }↴↴  prevKeys = keyboard.slice();↴}⇉⇇END⇉